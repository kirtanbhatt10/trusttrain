# Copy to .env and replace every placeholder. Never commit .env.

# development | test | production
TRUSTTRAIN_ENVIRONMENT=development

# PostgreSQL password used by docker-compose (generate a long random value).
POSTGRES_PASSWORD=change-me

# At least 32 random characters in production, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
TRUSTTRAIN_JWT_SECRET=change-me-to-a-long-random-secret
TRUSTTRAIN_JWT_TTL_MINUTES=60

# First administrator, created on start-up if it does not exist. Remove after first login.
TRUSTTRAIN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TRUSTTRAIN_BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

# Ed25519 private key (PEM, PKCS8). Required in production; auto-generated in development.
# TRUSTTRAIN_SIGNING_KEY_PATH=/data/signing-key.pem

# Local development without Docker (SQLite):
# TRUSTTRAIN_DATABASE_URL=sqlite:///./trusttrain-data/trusttrain.db
# TRUSTTRAIN_DATA_DIR=./trusttrain-data

TRUSTTRAIN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTTRAIN_MAX_UPLOAD_BYTES=52428800
TRUSTTRAIN_MAX_ROWS=200000
TRUSTTRAIN_MAX_TEXT_CHARS_PER_CELL=20000
TRUSTTRAIN_RATE_LIMIT_PER_MINUTE=240

# Optional: local sentence-transformers model for embeddings (falls back to TF-IDF/LSA).
# TRUSTTRAIN_EMBEDDING_MODEL=/models/all-MiniLM-L6-v2
